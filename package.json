{
    "name": "vignan-timetable-ai",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "start": "node server/dist/server.js",
        "preview": "vite preview",
        "postinstall": "prisma generate --schema=server/prisma/schema.prisma",
        "server:dev": "tsx watch server/server.ts",
        "server:build": "prisma generate --schema=server/prisma/schema.prisma && tsc -p server/tsconfig.json",
        "server:start": "node server/dist/server.js",
        "prisma:generate": "prisma generate --schema=server/prisma/schema.prisma",
        "prisma:migrate": "prisma migrate dev --schema=server/prisma/schema.prisma",
        "prisma:seed": "tsx server/prisma/seed.ts"
    },
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.2",
        "lucide-react": "^0.468.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router-dom": "^7.0.2",
        "recharts": "^2.15.0",
        "xlsx": "^0.18.5",
        "xlsx": "^0.18.5",
        "zod": "^3.23.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.5",
        "@types/express": "^5.0.0",
        "@types/node": "^22.10.2",
        "@types/react": "^19.0.2",
        "@types/react-dom": "^19.0.2",
        "@vitejs/plugin-react": "^5.0.0",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.4.49",
        "prisma": "^5.22.0",
        "tailwindcss": "^3.4.16",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "vite": "^6.0.5"
    }
}